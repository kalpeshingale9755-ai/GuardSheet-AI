# ==========================================
# GuardSheet AI Root .gitignore
# ==========================================

# ------------------------------------------
# Environment Files & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------
# Python Virtual Environments & Packages
# ------------------------------------------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# ------------------------------------------
# Python Cache & Bytecode
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.so
*.pyd

# ------------------------------------------
# Node Dependencies & Package Managers
# ------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Next.js & Frontend Build Output
# ------------------------------------------
.next/
**/next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
*.tsbuildinfo

# ------------------------------------------
# Local Runtime Storage & Generated Data
# ------------------------------------------
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/pages/*
!backend/storage/pages/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/pages/*
!storage/pages/.gitkeep

# ------------------------------------------
# Logs, Temporary Files & Test Caches
# ------------------------------------------
*.log
logs/
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
